DATABASE_URL=
REGISTRATION_CLOSED=1
NODE_ENV=production
TOKEN_SECRET=
VERBOSE=0
USER_GUILD_LIMIT=100
REDIS_URL=/run/valkey/valkey.sock
MAX_AVATAR_SIZE=10000000
MAX_BANNER_SIZE=25000000
MAX_ATTACHMENT_SIZE=25000000
# Link previews make the server fetch pages that users post, so those sites see its IP.
# Leave off in production unless that is acceptable.
LINK_PREVIEWS=0
CORS_ENABLED=1
# Public address of the site, used in invite link previews. Optional behind a proxy that
# forwards Host and X-Forwarded-Proto.
# PUBLIC_URL=https://chat.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

