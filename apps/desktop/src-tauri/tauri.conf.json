{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Vanilla",
	"version": "0.1.0",
	"identifier": "li.meetz.vanilla",
	"build": {
		"devUrl": "http://localhost:5173",
		"frontendDist": "../../frontend/dist"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"updater": {
			"endpoints": ["https://updates.invalid/latest.json"],
			"pubkey": "set at build time"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
