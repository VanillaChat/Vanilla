{
	"name": "@vanillachat/vauler",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --port 5173",
		"build:voice": "../../crates/voice/build-wasm.sh",
		"build": "bun run build:voice && tsc --noEmit && vite build",
		"serve": "vite preview",
		"start": "vite",
		"check": "biome ci .",
		"check:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test src/voice src/state src/components/message"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@fluent/bundle": "^0.19.1",
		"@fortawesome/fontawesome-free": "^7.2.0",
		"@sapphi-red/web-noise-suppressor": "^0.4.1",
		"@tailwindcss/postcss": "^4.1.13",
		"@tanstack/router-plugin": "^1.131.35",
		"@tanstack/solid-router": "^1.131.35",
		"@tanstack/solid-router-devtools": "^1.131.35",
		"@twemoji/parser": "^17.0.2",
		"emojibase-data": "^18.0.0",
		"highlight.js": "^11.12.0",
		"postcss": "8.5.10",
		"redaxios": "^0.5.1",
		"solid-js": "^1.9.9",
		"tailwindcss": "^4.1.13",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"solid-devtools": "^0.34.3",
		"typescript": "^5.9.2",
		"vite": "8.0.5",
		"vite-plugin-solid": "^2.11.9",
		"@types/bun": "^1.3.13"
	}
}
